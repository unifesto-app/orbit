{
  "name": "@orbit/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --test-concurrency=1 'src/**/*.test.ts'",
    "build": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/client-ses": "^3.1169.0",
    "@hono/node-server": "^1.19.0",
    "@orbit/contract": "workspace:*",
    "@simplewebauthn/server": "~14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.9.0",
    "ioredis": "^6.0.0",
    "postgres": "^4.1.1",
    "sharp": "0.35.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.0"
  }
}
