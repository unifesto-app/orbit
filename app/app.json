{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121215",
    "scheme": "orbitbyunifesto",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unifesto.orbit",
      "appleTeamId": "9AH3Z5C5DH",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unifesto.orbit",
      "adaptiveIcon": {
        "backgroundColor": "#121215",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbit uses your location to show events near you."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121215"
        }
      ],
      "./plugins/withAlwaysRunScripts",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "aaf1a40f-4301-4487-b046-b54c0c0fb032"
      }
    },
    "owner": "unifesto-app"
  }
}
