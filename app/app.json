{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121215",
    "scheme": "heyorbit",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.heyorbit.app",
      "appleTeamId": "9AH3Z5C5DH",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "usesAppleSignIn": true,
      "associatedDomains": [
        "webcredentials:heyorbit.in"
      ],
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "package": "in.heyorbit.app",
      "adaptiveIcon": {
        "backgroundColor": "#121215",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Orbit uses your location to show events near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#869381",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121215"
        }
      ],
      "./plugins/withAlwaysRunScripts",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Orbit uses your photos so you can choose your profile photo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "InOrbit",
            "ios": "./assets/icons/inorbit.png",
            "android": {
              "foregroundImage": "./assets/icons/inorbit-android.png",
              "backgroundColor": "#121215"
            }
          },
          {
            "name": "Heart",
            "ios": "./assets/icons/heart.png",
            "android": {
              "foregroundImage": "./assets/icons/heart-android.png",
              "backgroundColor": "#121215"
            }
          },
          {
            "name": "Glass",
            "ios": "./assets/icons/glass.png",
            "android": {
              "foregroundImage": "./assets/icons/glass-android.png",
              "backgroundColor": "#121215"
            }
          },
          {
            "name": "Ticket",
            "ios": "./assets/icons/ticket.png",
            "android": {
              "foregroundImage": "./assets/icons/ticket-android.png",
              "backgroundColor": "#121215"
            }
          },
          {
            "name": "Hologram",
            "ios": "./assets/icons/hologram.png",
            "android": {
              "foregroundImage": "./assets/icons/hologram-android.png",
              "backgroundColor": "#121215"
            }
          }
        ]
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@sentry/react-native",
        {
          "organization": "heyorbit",
          "project": "orbit-app"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "aaf1a40f-4301-4487-b046-b54c0c0fb032"
      }
    },
    "owner": "unifesto-app"
  }
}
