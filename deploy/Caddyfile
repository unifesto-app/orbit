# Orbit's own Caddy on orbit-server (deploy/docker-compose.yml). Nothing here is shared with Unifesto.
#
# Real client IPs. Every request comes from a Cloudflare edge (the server's security group admits only
# Cloudflare's ranges, on 443). Trust those ranges and read the visitor from Cf-Connecting-Ip; a request
# from any other address keeps its socket IP, so the header can't be forged. The API's rate limits read
# X-Forwarded-For, which the api block below sets from that (api/src/http.ts, clientIp).
# Source: https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-11-17). Re-check when touching this.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

# TLS: a Cloudflare Origin Certificate for heyorbit.in and *.heyorbit.in, valid to 2041, in ./certs on the
# server only (origin.pem, origin.key). Its key was made on the owner's Mac from a CSR; it is never committed.
# Cloudflare SSL/TLS mode is Full (strict).
(cf_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		# Only Cloudflare may connect: Authenticated Origin Pulls (global) is on for the heyorbit.in zone,
		# so every edge presents a client cert signed by this CA, and a direct hit on the origin IP fails the
		# handshake. Turn AOP off in Cloudflare only after removing this block, or every site goes down.
		# CA: https://developers.cloudflare.com/ssl/static/authenticated_origin_pull_ca.pem
		# CN=origin-pull.cloudflare.net, valid to 2029-11-01, SHA-256
		# 9A:1A:C2:B4:BE:15:F9:F2:7E:EE:20:A7:34:CB:A4:E9:89:8F:61:00:1B:3B:D7:C8:4B:69:B5:6A:3E:25:A2:B9
		client_auth {
			mode require_and_verify
			trust_pool inline {
				trust_der 
			}
		}
	}
	# Access logs: the CERT-In request record (every request, unsampled), kept 180 days, under /data (the
	# caddy_data volume) so redeploys keep them. roll_keep is raised so age, not file count, is the limit.
	log {
		output file /data/logs/access.log {
			roll_size 100MiB
			roll_keep 10000
			roll_keep_for 4320h
		}
	}
}

# Every app gets X-Forwarded-For as exactly the visitor's address, so a forged header never reaches one.
heyorbit.in {
	import cf_tls
	# Passkeys for heyorbit.in (api/src/auth/ways.ts): which apps may use them. Served here rather than by the web app,
	# which sends every other page to / until launch; each must answer 200 JSON with no redirect.
	# - iOS: team 9AH3Z5C5DH, bundle in.heyorbit.app (app.json's webcredentials:heyorbit.in).
	# - Android: empty until the Play/EAS signing key's SHA-256 is added as
	#   [{"relation":["delegate_permission/common.get_login_creds"],"target":{"namespace":"android_app",
	#   "package_name":"in.heyorbit.app","sha256_cert_fingerprints":["AA:BB:…"]}}], with its base64url form in
	#   the API's PASSKEY_ORIGINS as android:apk-key-hash:…; Android passkeys don't work until then.
	handle /.well-known/apple-app-site-association {
		header Content-Type application/json
		respond `{"webcredentials":{"apps":["9AH3Z5C5DH.in.heyorbit.app"]}}` 200
	}
	handle /.well-known/assetlinks.json {
		header Content-Type application/json
		respond `[]` 200
	}
	handle {
		reverse_proxy orbit-web:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

www.heyorbit.in {
	import cf_tls
	redir https://heyorbit.in{uri} 308
}

api.heyorbit.in {
	import cf_tls
	# Visits come only through the site's own /v (web app/v/route.ts), which reaches the API inside Docker and sets the
	# place and browser from the request; from outside, the API would take a stranger's word for them.
	respond /public/visit 404
	reverse_proxy orbit-api:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

galaxy.heyorbit.in {
	import cf_tls
	reverse_proxy orbit-galaxy:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Console: where hosts run their events (console/).
console.heyorbit.in {
	import cf_tls
	reverse_proxy orbit-console:3000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Any other name under the wildcard cert: the same client-cert check, then nothing. Without this block such a
# name would complete TLS without Cloudflare's client cert (client_auth applies per configured site).
*.heyorbit.in {
	import cf_tls
	abort
}
