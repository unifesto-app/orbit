{
  "cli": {
    "version": ">= 18.8.1",
    "appVersionSource": "remote"
  },
  "build": {
    "event-partner": {
      "corepack": true,
      "autoIncrement": true,
      "env": { "APP_VARIANT": "launch", "EXPO_PUBLIC_API_URL": "https://api.heyorbit.in" }
    },
    "play-partner": {
      "corepack": true,
      "autoIncrement": true,
      "env": { "APP_VARIANT": "station", "EXPO_PUBLIC_API_URL": "https://api.heyorbit.in" }
    }
  },
  "submit": {
    "event-partner": {},
    "play-partner": {}
  }
}
