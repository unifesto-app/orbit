{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true
  },
  // The Expo config and the tests run on Node, not React Native, so they stay out of the app's type world (Expo loads
  // the config itself; `node --test` runs the tests).
  "exclude": ["node_modules", "app.config.ts", "**/*.test.ts"]
}
