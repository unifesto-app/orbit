     }
 
     public void onActivityResult(int requestCode, int resultCode, Intent data) {
+        // Orbit: react-native-customui shares request code 62442 and answers with 62443. That result is Custom UI's;
+        // handling it here would emit a bogus Razorpay::PAYMENT_ERROR that Custom UI's JS listener takes as its own.
+        if (resultCode == 62443) return;
         Checkout.handleActivityResult(getCurrentActivity(), requestCode, resultCode, data, this, this);
     }
 
